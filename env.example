# Local Government Website Configuration
# Copy this file to .env.local and update with your government's information

# Government Information
VITE_GOVERNMENT_NAME="San Pablo City"
VITE_GOVERNMENT_TYPE="City"
VITE_REGION="Region IV-A (CALABARZON)"
VITE_PROVINCE="Laguna"

# Website Information
VITE_WEBSITE_URL="https://www.sanpablocity.gov.ph"
VITE_CONTACT_EMAIL="admin@sanpablocity.gov.ph"
VITE_CONTACT_PHONE="(049) 561-1483"

# Social Media (Optional)
VITE_FACEBOOK_URL="https://www.facebook.com/ciospc"
VITE_TWITTER_URL=""
VITE_INSTAGRAM_URL=""
VITE_YOUTUBE_URL=""

# SEO
VITE_SITE_DESCRIPTION="Community-powered transparency and services portal for San Pablo City, Laguna, the City of Seven Lakes."
VITE_SITE_KEYWORDS="San Pablo City, Laguna, City of Seven Lakes, local government, government services, transparency portal, 80 barangays"
VITE_OG_IMAGE_URL="https://www.sanpablocity.gov.ph/og-image.jpg"
VITE_TWITTER_HANDLE=""

# Analytics (Optional)
VITE_GOOGLE_ANALYTICS_ID=""
VITE_FACEBOOK_PIXEL_ID=""
